"""Root BUILD.bazel for omux.xoxd.ai."""

load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_run_binary", "js_test")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//:vitest/package_json.bzl", vitest = "bin")

npm_link_all_packages(name = "node_modules")

filegroup(
    name = "srcs",
    srcs = glob([
        "docs/**",
        "src/**",
        "static/**",
    ]) + [
        ".npmrc",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "svelte.config.js",
        "tsconfig.json",
        "vitest.config.ts",
        "vite.config.ts",
    ],
)

exports_files(
    [
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
    ],
    visibility = ["//visibility:public"],
)

js_binary(
    name = "sveltekit_sync",
    data = [":node_modules"],
    entry_point = "run-sveltekit-sync.mjs",
)

js_run_binary(
    name = "sveltekit_types",
    srcs = [":srcs"],
    out_dirs = [".svelte-kit"],
    tool = ":sveltekit_sync",
)

js_binary(
    name = "vite_build",
    data = [":node_modules"],
    entry_point = "run-vite-build.mjs",
)

js_run_binary(
    name = "build",
    srcs = [
        ":srcs",
        ":sveltekit_types",
    ],
    out_dirs = ["build"],
    patch_node_fs = False,
    tool = ":vite_build",
    visibility = ["//visibility:public"],
)

js_test(
    name = "playwright_chromium_smoke",
    data = [
        ":build",
        ":node_modules",
        "run-playwright-chromium-smoke.mjs",
    ],
    entry_point = "run-playwright-chromium-smoke.mjs",
    tags = [
        "chromium",
        "gloriousflywheel-rbe-candidate",
        "playwright",
    ],
    timeout = "moderate",
    visibility = ["//visibility:public"],
)

js_test(
    name = "puppeteer_chromium_smoke",
    data = [
        ":build",
        ":node_modules",
        "run-puppeteer-chromium-smoke.mjs",
    ],
    entry_point = "run-puppeteer-chromium-smoke.mjs",
    tags = [
        "chromium",
        "gloriousflywheel-rbe-candidate",
        "puppeteer",
    ],
    timeout = "moderate",
    visibility = ["//visibility:public"],
)

vitest.vitest_test(
    name = "unit_tests",
    data = [
        ":node_modules",
        ":srcs",
        "vitest.config.ts",
    ],
    args = [
        "run",
        "--reporter=verbose",
        "--config",
        "$(rootpath vitest.config.ts)",
    ],
    tags = [
        "gloriousflywheel-rbe-candidate",
        "vitest",
    ],
    visibility = ["//visibility:public"],
)
